generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model State {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")
  districts District[]
  news      News[]
  reporters Reporter[]
  users     User[]

  @@map("states")
}

model District {
  id        String     @id @default(cuid())
  name      String
  stateId   String     @map("state_id")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")
  state     State      @relation(fields: [stateId], references: [id])
  mandals   Mandal[]
  news      News[]
  reporters Reporter[]
  users     User[]

  @@map("districts")
}

model Mandal {
  id         String     @id @default(cuid())
  name       String
  districtId String     @map("district_id")
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")
  district   District   @relation(fields: [districtId], references: [id])
  news       News[]
  reporters  Reporter[]
  users      User[]

  @@map("mandals")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  iconUrl   String?   @map("icon_url")
  color     String?
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  news      News[]
  videos    Video[]

  @@map("categories")
}

model Tag {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  type       String    @default("topic")
  isTrending Boolean   @default(false) @map("is_trending")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  news       NewsTag[]

  @@map("tags")
}

model NewsTag {
  id     String @id @default(cuid())
  newsId String @map("news_id")
  tagId  String @map("tag_id")
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([newsId, tagId])
  @@map("news_tags")
}

model Admin {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  avatar       String?
  role         String     @default("editor")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  auditLogs    AuditLog[]
  news         News[]

  @@map("admins")
}

model Reporter {
  id                 String    @id @default(cuid())
  name               String
  phone              String    @unique
  email              String?
  avatar             String?
  bio                String?
  stateId            String    @map("state_id")
  districtId         String    @map("district_id")
  mandalId           String?   @map("mandal_id")
  beat               String?
  status             String    @default("pending")
  canPublishDirectly Boolean   @default(false) @map("can_publish_directly")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  idProofUrl         String?   @map("id_proof_url")
  coinsBalance       Int       @default(0) @map("coins_balance")
  news               News[]
  walletTransactions WalletTransaction[]
  withdrawalRequests WithdrawalRequest[]
  district           District  @relation(fields: [districtId], references: [id])
  mandal             Mandal?   @relation(fields: [mandalId], references: [id])
  state              State     @relation(fields: [stateId], references: [id])

  @@map("reporters")
}

model User {
  id                  String          @id @default(cuid())
  phone               String          @unique
  name                String?
  email               String?
  avatar              String?
  stateId             String?         @map("state_id")
  districtId          String?         @map("district_id")
  mandalId            String?         @map("mandal_id")
  preferredLanguage   String          @default("te") @map("preferred_language")
  fcmToken            String?         @map("fcm_token")
  isActive            Boolean         @default(true) @map("is_active")
  isPremium           Boolean         @default(false) @map("is_premium")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  deletedAt           DateTime?       @map("deleted_at")
  preferredCategories String          @default("[]") @map("preferred_categories")
  bookmarks           Bookmark[]
  comments            Comment[]
  newsReactions       NewsReaction[]
  district            District?       @relation(fields: [districtId], references: [id])
  mandal              Mandal?         @relation(fields: [mandalId], references: [id])
  state               State?          @relation(fields: [stateId], references: [id])
  videoReactions      VideoReaction[]

  @@map("users")
}

model News {
  id           String         @id @default(cuid())
  title        String
  shortDesc    String?        @map("short_desc")
  content      String?
  categoryId   String         @map("category_id")
  stateId      String         @map("state_id")
  districtId   String?        @map("district_id")
  mandalId     String?        @map("mandal_id")
  thumbnailUrl String         @map("thumbnail_url")
  imagesUrls   String         @default("[]") @map("images_urls")
  videoUrl     String?        @map("video_url")
  sourceType   String         @default("original") @map("source_type")
  reporterId   String?        @map("reporter_id")
  priority     String         @default("normal")
  status       String         @default("draft")
  rejectReason String?        @map("reject_reason")
  publishedAt  DateTime?      @map("published_at")
  expiresAt    DateTime?      @map("expires_at")
  isFeatured   Boolean        @default(false) @map("is_featured")
  viewsCount   Int            @default(0) @map("views_count")
  sharesCount  Int            @default(0) @map("shares_count")
  createdBy    String         @map("created_by")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")
  bookmarks    Bookmark[]
  comments     Comment[]
  category     Category       @relation(fields: [categoryId], references: [id])
  admin        Admin          @relation(fields: [createdBy], references: [id])
  district     District?      @relation(fields: [districtId], references: [id])
  mandal       Mandal?        @relation(fields: [mandalId], references: [id])
  reporter     Reporter?      @relation(fields: [reporterId], references: [id])
  state        State          @relation(fields: [stateId], references: [id])
  reactions            NewsReaction[]
  tags                 NewsTag[]
  youtubePublishStatus String?        @map("youtube_publish_status")
  youtubeVideoId       String?        @map("youtube_video_id")

  @@index([status, publishedAt(sort: Desc), districtId])
  @@index([status, publishedAt(sort: Desc), categoryId])
  @@map("news")
}

model Video {
  id           String          @id @default(cuid())
  title        String
  description  String?
  videoUrl     String          @map("video_url")
  thumbnailUrl String?         @map("thumbnail_url")
  duration     Int             @default(0)
  categoryId   String?         @map("category_id")
  status       String          @default("draft")
  viewsCount   Int             @default(0) @map("views_count")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  deletedAt    DateTime?       @map("deleted_at")
  reactions            VideoReaction[]
  category             Category?       @relation(fields: [categoryId], references: [id])
  youtubePublishStatus String?         @map("youtube_publish_status")
  youtubeVideoId       String?         @map("youtube_video_id")

  @@map("videos")
}

model CustomAd {
  id                String    @id @default(cuid())
  title             String
  advertiser        String
  type              String    @default("image")
  imagesUrls        String    @default("[]") @map("images_urls")
  layout            String    @default("grid")
  videoUrl          String?   @map("video_url")
  clickUrl          String?   @map("click_url")
  buttonText        String?   @map("button_text")
  placement         String    @default("feed_inline")
  frequency         Int       @default(5) @map("frequency")
  targetStateIds    String    @default("[]") @map("target_state_ids")
  targetCategoryIds String    @default("[]") @map("target_category_ids")
  impressionsLimit  Int       @default(0) @map("impressions_limit")
  impressionsServed Int       @default(0) @map("impressions_served")
  clicksServed      Int       @default(0) @map("clicks_served")
  startDate         DateTime? @map("start_date")
  endDate           DateTime? @map("end_date")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@map("custom_ads")
}

model PushNotification {
  id             String    @id @default(cuid())
  title          String
  body           String
  imageUrl       String?   @map("image_url")
  targetType     String    @default("all")
  targetValue    String?   @map("target_value")
  newsId         String?   @map("news_id")
  scheduledAt    DateTime? @map("scheduled_at")
  status         String    @default("draft")
  sentCount      Int       @default(0) @map("sent_count")
  deliveredCount Int       @default(0) @map("delivered_count")
  openedCount    Int       @default(0) @map("opened_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@map("push_notifications")
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String   @map("admin_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  ipAddress String?  @map("ip_address")
  changes   String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  admin     Admin    @relation(fields: [adminId], references: [id])

  @@map("audit_logs")
}

model Media {
  id           String    @id @default(cuid())
  filename     String
  originalUrl  String    @map("original_url")
  thumbnailUrl String?   @map("thumbnail_url")
  mimeType     String?   @map("mime_type")
  size         Int       @default(0)
  alt          String?
  uploadedBy   String?   @map("uploaded_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@map("media")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  newsId    String   @map("news_id")
  createdAt DateTime @default(now()) @map("created_at")
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, newsId])
  @@map("bookmarks")
}

model NewsReaction {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  newsId    String   @map("news_id")
  type      String   @default("like")
  createdAt DateTime @default(now()) @map("created_at")
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, newsId])
  @@map("news_reactions")
}

model VideoReaction {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  videoId   String   @map("video_id")
  type      String   @default("like")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@map("video_reactions")
}

model Comment {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  newsId    String    @map("news_id")
  content   String
  parentId  String?   @map("parent_id")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  news      News      @relation(fields: [newsId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([newsId, createdAt(sort: Desc)])
  @@map("comments")
}

model WalletTransaction {
  id          String   @id @default(cuid())
  reporterId  String   @map("reporter_id")
  amount      Int
  type        String   // "CREDIT" or "DEBIT"
  description String
  referenceId String?  @map("reference_id") // ID of news/video or withdrawal request
  createdAt   DateTime @default(now()) @map("created_at")
  reporter    Reporter @relation(fields: [reporterId], references: [id])

  @@map("wallet_transactions")
}

model WithdrawalRequest {
  id          String   @id @default(cuid())
  reporterId  String   @map("reporter_id")
  coinsAmount Int      @map("coins_amount")
  moneyAmount Float    @map("money_amount")
  upiId       String   @map("upi_id")
  status      String   @default("pending") // "pending", "processing", "completed", "rejected"
  adminNotes  String?  @map("admin_notes")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  reporter    Reporter @relation(fields: [reporterId], references: [id])

  @@map("withdrawal_requests")
}
